# AI agent shared environment for mcp-server and mcp-client
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
FASTMCP_TRANSPORT=sse

PROMETHEUS_URL=http://prometheus:9090
NODE_DEVICE_HOSTNAME=uvais-HP-Z1-G9-Tower-Desktop-PC

MCP_SERVER_URL=http://mcp-server:8000/sse

GEMINI_API_KEY=<enter-your-gemini-api-key>
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=<enter-your-openai-api-key>
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ALLOWED_ORIGIN=*
RAG_ENABLED=true
QDRANT_URL=<enter-your-qdrant-url>
QDRANT_API_KEY=<enter-your-qdrant-api-key>
QDRANT_COLLECTION_NAME=device_metrics
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBED_DIM=768
