# AI agent shared environment for mcp-server and mcp-client
FASTMCP_HOST=0.0.0.0
FASTMCP_PORT=8000
FASTMCP_TRANSPORT=sse

PROMETHEUS_URL=http://prometheus:9090
NODE_DEVICE_HOSTNAME=uvais-HP-Z1-G9-Tower-Desktop-PC

MCP_SERVER_URL=https://mcp-server:8000/sse
# Internal Docker service-to-service TLS uses the shared REST certs, which do not
# normally match the Docker DNS name `mcp-server`. Keep verification disabled
# unless you provision a cert that matches the internal hostname and trust chain.
VERIFY_TLS=false
SSL_CERTFILE=/app/certs/restapi-cert.pem
SSL_KEYFILE=/app/certs/restapi-key.pem

GEMINI_API_KEY=<enter-your-gemini-api-key>
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

OPENAI_API_KEY=<enter-your-openai-api-key>
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

PRODUCTION_MODE=true
REQUIRE_API_KEY=true
# Keep this value in sync with the X-API-Key configured in owgw-ui/default.conf.
AGENT_API_KEY=<enter-a-strong-random-ai-agent-api-key>
ALLOWED_ORIGIN=https://openwifi.wlan.local
ALLOW_LLM_PROMQL=true
LOG_LLM_PROMPTS=true
RAG_ENABLED=false
QDRANT_URL=<enter-your-qdrant-url>
QDRANT_API_KEY=<enter-your-qdrant-api-key>
QDRANT_COLLECTION_NAME=device_metrics
EMBEDDING_MODEL_NAME=text-embedding-3-small
EMBED_DIM=768

ALERTING_ENABLED=true
ALERT_INTERVAL_SECONDS=60
ALERT_REPEAT_INTERVAL_SECONDS=1800
ALERT_WORKER_RESTART_DELAY_SECONDS=5
ALERT_SEND_RECOVERY=true
ALERT_USE_LLM=true
ALERT_LLM_ONLY_FOR_CRITICAL=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=<enter-your-smtp-username>
SMTP_PASSWORD=<enter-your-smtp-password>
SMTP_FROM=<enter-your-smtp-from-address>
SMTP_TO=<enter-your-smtp-to-address>
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20
SMTP_SEND_TIMEOUT_SECONDS=25
SMTP_MAX_RETRIES=2
SMTP_RETRY_BACKOFF_SECONDS=1.5
